# ── Backend ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
UPLOAD_DESTINATION_PATH=/mnt/media
MAX_FILE_SIZE=10737418240
SETTINGS_FILE=./settings.json

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# For local development:
VITE_API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173

# ── Option A: Pi WiFi access point (field use, no router needed) ──────────────
# Run scripts/setup-ap.sh first, then use these values instead.
#
# VITE_API_URL=http://10.42.0.1:5000
# CORS_ORIGIN=http://10.42.0.1:5173

# ── Option B: Pi on your home network ─────────────────────────────────────────
# Replace 192.168.1.100 with your Pi's IP (find it with: hostname -I).
#
# VITE_API_URL=http://192.168.1.100:5000
# CORS_ORIGIN=http://192.168.1.100:5173
